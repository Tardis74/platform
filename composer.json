{
  "name": "lyceum/platform",
  "description": "Web platform for lyceum automation",
  "type": "project",
  "require": {
    "php": ">=7.4",
    "firebase/php-jwt": "^6.0",
    "ext-pdo": "*",
    "ext-json": "*"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "audit": {
      "ignore": [ "PKSA-y2cr-5h3j-g3ys" ]
    }
  }
}